generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------- auth

enum Role {
  USER
  BUSINESS
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
  reviews       Review[]
  reviewVotes   ReviewVote[]
  reviewReports ReviewReport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- catalog

// Flat by design: the list mirrors Google Business Profile's ~4,000 categories,
// which are already leaf-level, so a parent/child tree only added a step to
// every picker without telling anyone anything.
model Category {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  icon         String?
  description  String? @db.Text
  listingCount Int     @default(0)
  sort         Int     @default(0)

  businesses Business[]
  extraFor   Business[] @relation("BusinessExtraCategories")

  @@index([name])
}

enum BusinessStatus {
  PENDING
  LIVE
  REJECTED
  SUSPENDED
}

model Business {
  id          String  @id @default(cuid())
  ownerId     String
  categoryId  Int
  slug        String  @unique
  name        String
  email       String
  phone       String
  website     String?
  tagline     String?
  description String? @db.Text
  foundedYear Int?
  whatsapp    String?
  instagram   String?
  facebook    String?
  mapUrl      String? @db.Text
  logo        String?
  cover       String?

  address String?
  city    String
  state   String
  pincode String?

  status            BusinessStatus @default(PENDING)
  // owner-facing embed badge; admins revoke it when the credit link is stripped
  badgeEnabled      Boolean        @default(true)
  verifiedAt        DateTime?
  verifyRequestedAt DateTime?
  reviewsSeenAt     DateTime? // when the owner last opened this business's reviews

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)
  // rating histogram, denormalized so the profile page never aggregates
  rating1     Int     @default(0)
  rating2     Int     @default(0)
  rating3     Int     @default(0)
  rating4     Int     @default(0)
  rating5     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // categoryId is the primary one — it decides the breadcrumb and the badge.
  // extraCategories are the other trades the same business is listed under.
  category   Category        @relation(fields: [categoryId], references: [id])
  extraCategories Category[] @relation("BusinessExtraCategories")
  hours      BusinessHour[]
  images     BusinessImage[]
  reviews    Review[]
  replies    ReviewReply[]
  badgeViews BadgeView[]

  @@index([ownerId])
  @@index([categoryId, status])
  @@index([city, status])
  @@index([status, ratingAvg])
  @@index([name])
}

model BusinessHour {
  id         Int     @id @default(autoincrement())
  businessId String
  day        Int // 0 = Sunday
  openTime   String?
  closeTime  String?
  closed     Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model BusinessImage {
  id         Int    @id @default(autoincrement())
  businessId String
  path       String
  sort       Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// One row per business + embedding domain + day. Written from a buffered
/// counter so a busy customer site does not turn into one INSERT per visitor.
model BadgeView {
  id         Int      @id @default(autoincrement())
  businessId String
  domain     String // referring host, "direct" when the request sends no Referer
  day        DateTime @db.Date
  views      Int      @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, domain, day])
  @@index([businessId, day])
}

// ---------------------------------------------------------------- reviews

enum ReviewStatus {
  LIVE
  PENDING
  REMOVED
}

model Review {
  id           String       @id @default(cuid())
  businessId   String
  userId       String
  rating       Int
  title        String
  body         String       @db.Text
  status       ReviewStatus @default(LIVE)
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images   ReviewImage[]
  reply    ReviewReply?
  votes    ReviewVote[]
  reports  ReviewReport[]

  // one review per user per business, enforced at the DB
  @@unique([businessId, userId])
  @@index([businessId, status, createdAt])
  @@index([userId])
  @@index([status])
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId String
  path     String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewReply {
  id         Int      @id @default(autoincrement())
  reviewId   String   @unique
  businessId String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ReviewVote {
  id       Int    @id @default(autoincrement())
  reviewId String
  userId   String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id        Int          @id @default(autoincrement())
  reviewId  String
  userId    String
  reason    String
  detail    String?      @db.Text
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
}

// ---------------------------------------------------------------- admin

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String // admin user id
  actorEmail String
  action    String // e.g. business.approve, review.remove, user.role, category.delete
  entity    String // business | review | report | user | category
  entityId  String
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
