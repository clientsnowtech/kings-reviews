# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# deploy staging: the new build lands here, then swaps in with a mv
/.next-build/
/.next-previous/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# user uploads
/public/uploads

# env files (can opt-in for committing if needed)
.env*
# the deploy template holds placeholders only, so it is safe to track
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
