generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------- auth

enum Role {
  USER
  BUSINESS
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Two-factor (TOTP). The secret is written when setup starts but only trusted
  // once twoFactorEnabled flips, so an abandoned setup locks nobody out.
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorAt      DateTime?
  /// JSON array of sha256 hashes — one-time codes for a lost phone
  twoFactorCodes   String?   @db.Text

  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
  reviews       Review[]
  reviewVotes   ReviewVote[]
  reviewReports ReviewReport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- catalog

// Flat by design: the list mirrors Google Business Profile's ~4,000 categories,
// which are already leaf-level, so a parent/child tree only added a step to
// every picker without telling anyone anything.
model Category {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  icon         String?
  description  String? @db.Text
  listingCount Int     @default(0)
  sort         Int     @default(0)

  businesses Business[]
  extraFor   Business[] @relation("BusinessExtraCategories")

  @@index([name])
}

enum BusinessStatus {
  PENDING
  LIVE
  REJECTED
  SUSPENDED
}

model Business {
  id          String  @id @default(cuid())
  ownerId     String
  categoryId  Int
  slug        String  @unique
  name        String
  email       String
  phone       String
  website     String?
  tagline     String?
  description String? @db.Text
  foundedYear Int?
  whatsapp    String?
  instagram   String?
  facebook    String?
  mapUrl      String? @db.Text
  logo        String?
  cover       String?

  address String?
  city    String
  state   String
  pincode String?

  // Who we talk to at the business, as opposed to the switchboard above. Kept
  // off every public page on purpose: this is a named person, and nobody
  // listing a shop expects their own number on the profile.
  contactName  String?
  contactRole  String?
  contactEmail String?
  contactPhone String?

  // the CSV run that created this row, so one bad import can be undone whole
  importId          String?
  // scans of the printed QR card — otherwise the print is invisible to its owner
  qrScans           Int            @default(0)

  status            BusinessStatus @default(PENDING)
  // owner-facing embed badge; admins revoke it when the credit link is stripped
  badgeEnabled      Boolean        @default(true)
  verifiedAt        DateTime?
  verifyRequestedAt DateTime?
  reviewsSeenAt     DateTime? // when the owner last opened this business's reviews

  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)
  // rating histogram, denormalized so the profile page never aggregates
  rating1     Int     @default(0)
  rating2     Int     @default(0)
  rating3     Int     @default(0)
  rating4     Int     @default(0)
  rating5     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // categoryId is the primary one — it decides the breadcrumb and the badge.
  // extraCategories are the other trades the same business is listed under.
  category   Category        @relation(fields: [categoryId], references: [id])
  extraCategories Category[] @relation("BusinessExtraCategories")
  hours      BusinessHour[]
  images     BusinessImage[]
  reviews    Review[]
  replies    ReviewReply[]
  badgeViews BadgeView[]

  @@index([ownerId])
  @@index([categoryId, status])
  @@index([city, status])
  // the state filter and the city-by-state dropdown, which scanned the whole
  // table once the directory passed a hundred thousand listings
  @@index([state, city])
  @@index([status, ratingAvg])
  @@index([name])
  @@index([importId])
}

model BusinessHour {
  id         Int     @id @default(autoincrement())
  businessId String
  day        Int // 0 = Sunday
  openTime   String?
  closeTime  String?
  closed     Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
}

model BusinessImage {
  id         Int    @id @default(autoincrement())
  businessId String
  path       String
  sort       Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// One row per business + embedding domain + day. Written from a buffered
/// counter so a busy customer site does not turn into one INSERT per visitor.
model BadgeView {
  id         Int      @id @default(autoincrement())
  businessId String
  domain     String // referring host, "direct" when the request sends no Referer
  day        DateTime @db.Date
  views      Int      @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, domain, day])
  @@index([businessId, day])
}

// ---------------------------------------------------------------- reviews

enum ReviewStatus {
  LIVE
  PENDING
  REMOVED
}

model Review {
  id           String       @id @default(cuid())
  businessId   String
  userId       String
  rating       Int
  title        String
  body         String       @db.Text
  // reviews are never published on submit — a human approves them first
  status       ReviewStatus @default(PENDING)
  // why a review was rejected, and when it was decided. The reviewer sees the
  // reason, so a rejection is an answer rather than a silence.
  rejectReason String?      @db.Text
  moderatedAt  DateTime?
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images   ReviewImage[]
  reply    ReviewReply?
  votes    ReviewVote[]
  reports  ReviewReport[]

  // one review per user per business, enforced at the DB
  @@unique([businessId, userId])
  @@index([businessId, status, createdAt])
  @@index([userId])
  @@index([status])
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId String
  path     String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewReply {
  id         Int      @id @default(autoincrement())
  reviewId   String   @unique
  businessId String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ReviewVote {
  id       Int    @id @default(autoincrement())
  reviewId String
  userId   String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id        Int          @id @default(autoincrement())
  reviewId  String
  userId    String
  reason    String
  detail    String?      @db.Text
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
}

/// Extra blocked words on top of the built-in list in src/lib/moderation.ts.
/// Abuse vocabulary moves faster than releases, so admins own this table.
model BlockedWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- admin

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String // admin user id
  actorEmail String
  action    String // e.g. business.approve, review.remove, user.role, category.delete
  entity    String // business | review | report | user | category
  entityId  String
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- email

/// SMTP credentials, held in the database so an admin can paste a Brevo key
/// and rotate it without a deploy or a server restart. One row, id 1 — the
/// environment variables still work and are read when this row is missing.
model MailSetting {
  id        Int      @id @default(1)
  host      String   @default("smtp-relay.brevo.com")
  port      Int      @default(587)
  username  String   @default("")
  /// AES-256-GCM, keyed from AUTH_SECRET — never stored as it was typed
  password  String   @default("") @db.Text
  fromName  String   @default("TrustIndex")
  fromEmail String   @default("")
  /// off keeps the settings but stops sending, the way no settings at all does
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum EmailStatus {
  SENT
  FAILED
  /// no transport configured, or sending switched off — the mail never left
  SKIPPED
}

/// What actually went out. sendMail swallows transport errors on purpose, so
/// without this row an admin has no way to tell a delivered notification from
/// one that died inside a try/catch.
model EmailLog {
  id        Int         @id @default(autoincrement())
  to        String
  subject   String
  status    EmailStatus
  error     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([createdAt])
}
