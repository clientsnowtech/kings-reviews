# Production environment for https://www.kingsreviews.com
# Copy to the server as .env (or paste these into the host's env panel).
# Never commit the filled-in version — real secrets stay out of git.

# --- database -------------------------------------------------------------
# A dedicated production database. Do NOT point this at the dev DB: that one
# carries ~100 seeded demo businesses.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/kingsreviews"

# --- auth -----------------------------------------------------------------
# Fresh secret, different from the dev one. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="REPLACE_ME"

# Must match the public origin exactly, including www — NextAuth builds its
# callback URLs from this, so a mismatch breaks login and Google sign-in.
AUTH_URL="https://www.kingsreviews.com"

# --- app ------------------------------------------------------------------
# Canonical origin: sitemap, robots, OG tags and the embeddable badge
# snippets are all built from this.
NEXT_PUBLIC_APP_URL="https://www.kingsreviews.com"
NEXT_PUBLIC_APP_NAME="Kings Reviews"

# --- measurement ----------------------------------------------------------
# Public identifiers, not secrets — they ship inside the page HTML either way.
# Both tags stay unloaded until a visitor grants the analytics category, so
# leaving these set does not put a cookie on anyone who said no. Leave them
# blank in dev unless you want your own clicks in the reports.
NEXT_PUBLIC_GA_ID="G-QFQC7L4B0T"
NEXT_PUBLIC_CLARITY_ID="xz22b27ib0"

# Proves domain ownership to Search Console and Yandex Webmaster. Plain meta
# tags, no cookie, so they render for everyone regardless of consent. Both are
# read at build time, so a change needs a redeploy before the tag moves.
NEXT_PUBLIC_GOOGLE_VERIFICATION="IYcDz9G2H8zZ9hRegJSxpQ-lBW4htvL57c8bPZY6Opg"
NEXT_PUBLIC_YANDEX_VERIFICATION="582c1ae8b9adb6ef"

# --- google sign-in -------------------------------------------------------
# In Google Cloud Console the OAuth client must list
#   https://www.kingsreviews.com/api/auth/callback/google
# as an authorised redirect URI, and the domain as an authorised origin.
AUTH_GOOGLE_ID="REPLACE_ME"
AUTH_GOOGLE_SECRET="REPLACE_ME"

# --- reviews --------------------------------------------------------------
# Reviews are submitted as PENDING and wait for the owner or an admin. This is
# the deadline: after this many days a review from a verified account
# publishes itself, so an owner cannot bury criticism by ignoring it.
# Set to 0 to disable auto-publishing (not recommended).
REVIEW_AUTO_PUBLISH_DAYS="7"

# --- email ----------------------------------------------------------------
# Optional, and only a fallback: Admin → Communication holds the same settings
# in the database, and anything saved there wins over what is below. These are
# for a first deploy, before anyone can reach the panel.
# Without either, notifications are logged as skipped and nothing breaks —
# owners just have to check the dashboard themselves.
#
# For Brevo: host smtp-relay.brevo.com, port 587, user is the SMTP login shown
# under "SMTP & API" (9xxxxx001@smtp-brevo.com, not the account email), pass is
# the SMTP key, and MAIL_FROM must be a sender verified inside Brevo.
# Either one URL:
#   SMTP_URL="smtps://user:pass@mail.example.com:465"
# or the separate fields:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kings Reviews <no-reply@kingsreviews.com>"
