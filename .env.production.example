# Production environment for https://www.trustindexindia.com
# Copy to the server as .env (or paste these into the host's env panel).
# Never commit the filled-in version — real secrets stay out of git.

# --- database -------------------------------------------------------------
# A dedicated production database. Do NOT point this at the dev DB: that one
# carries ~100 seeded demo businesses.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/trustindex"

# --- auth -----------------------------------------------------------------
# Fresh secret, different from the dev one. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="REPLACE_ME"

# Must match the public origin exactly, including www — NextAuth builds its
# callback URLs from this, so a mismatch breaks login and Google sign-in.
AUTH_URL="https://www.trustindexindia.com"

# --- app ------------------------------------------------------------------
# Canonical origin: sitemap, robots, OG tags and the embeddable badge
# snippets are all built from this.
NEXT_PUBLIC_APP_URL="https://www.trustindexindia.com"
NEXT_PUBLIC_APP_NAME="TrustIndex India"

# --- google sign-in -------------------------------------------------------
# In Google Cloud Console the OAuth client must list
#   https://www.trustindexindia.com/api/auth/callback/google
# as an authorised redirect URI, and the domain as an authorised origin.
AUTH_GOOGLE_ID="REPLACE_ME"
AUTH_GOOGLE_SECRET="REPLACE_ME"

# --- reviews --------------------------------------------------------------
# Reviews are submitted as PENDING and wait for the owner or an admin. This is
# the deadline: after this many days a review from a verified account
# publishes itself, so an owner cannot bury criticism by ignoring it.
# Set to 0 to disable auto-publishing (not recommended).
REVIEW_AUTO_PUBLISH_DAYS="7"

# --- email ----------------------------------------------------------------
# Optional. Without these, notifications are logged and skipped — nothing
# breaks, owners just have to check the dashboard themselves.
# Either one URL:
#   SMTP_URL="smtps://user:pass@mail.example.com:465"
# or the separate fields:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TrustIndex <no-reply@trustindexindia.com>"
